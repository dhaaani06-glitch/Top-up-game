<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard — TopUp Store</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, 'Segoe UI', sans-serif; }

:root {
  --bg: #0f1420;
  --card: #1a2135;
  --card-2: #232c45;
  --border: #2f3a56;
  --text: #e8edff;
  --muted: #8892b8;
  --accent: #4f7cff;
  --accent-2: #7c5cff;
  --green: #22c55e;
  --yellow: #eab308;
  --red: #ef4444;
}

body {
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  font-size: 14px;
}

/* ============ LOGIN ============ */
.login-screen {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: radial-gradient(circle at 30% 20%, rgba(79,124,255,0.15), transparent 50%),
              radial-gradient(circle at 70% 80%, rgba(124,92,255,0.15), transparent 50%);
}
.login-box {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 32px 26px;
  max-width: 400px;
  width: 100%;
  box-shadow: 0 20px 60px rgba(0,0,0,0.5);
}
.login-logo {
  width: 56px; height: 56px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  display: flex; align-items: center; justify-content: center;
  font-size: 1.6rem;
  margin: 0 auto 18px;
}
.login-box h1 {
  text-align: center;
  font-size: 1.3rem;
  margin-bottom: 6px;
}
.login-box .sub {
  text-align: center;
  color: var(--muted);
  font-size: 0.85rem;
  margin-bottom: 26px;
}
.form-group { margin-bottom: 14px; }
.form-group label {
  display: block;
  font-size: 0.8rem;
  color: var(--muted);
  margin-bottom: 6px;
}
.form-group input {
  width: 100%;
  padding: 12px 14px;
  background: var(--card-2);
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text);
  font-size: 0.92rem;
  outline: none;
}
.form-group input:focus { border-color: var(--accent); }

.btn {
  padding: 12px 18px;
  border-radius: 10px;
  border: none;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  white-space: nowrap;
}
.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: white;
  width: 100%;
  padding: 13px;
}
.btn-primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(79,124,255,0.4); }
.btn-green { background: var(--green); color: white; }
.btn-red { background: var(--red); color: white; }
.btn-ghost {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--muted);
}
.btn-ghost:hover { color: var(--text); border-color: var(--accent); }

.alert {
  padding: 10px 14px;
  border-radius: 9px;
  font-size: 0.83rem;
  margin-top: 12px;
  display: none;
}
.alert.show { display: block; }
.alert-error { background: rgba(239,68,68,0.15); color: #fca5a5; border: 1px solid rgba(239,68,68,0.3); }

/* ============ DASHBOARD ============ */
.dashboard { display: none; min-height: 100vh; }
.dashboard.show { display: block; }

.topbar {
  background: var(--card);
  border-bottom: 1px solid var(--border);
  padding: 14px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 30;
}
.topbar-left { display: flex; align-items: center; gap: 12px; }
.topbar-icon {
  width: 36px; height: 36px;
  border-radius: 9px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem;
}
.topbar-title { font-weight: 700; font-size: 0.95rem; }
.topbar-user { font-size: 0.75rem; color: var(--muted); }

.container { max-width: 1100px; margin: 0 auto; padding: 20px; }

/* Stats */
.stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 12px;
  margin-bottom: 22px;
}
.stat {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
}
.stat-label {
  font-size: 0.72rem;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 8px;
}
.stat-value {
  font-size: 1.5rem;
  font-weight: 800;
}
.stat-value.green { color: var(--green); }
.stat-value.yellow { color: var(--yellow); }
.stat-value.accent { color: var(--accent); }

/* Filter tabs */
.filters {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 4px;
  margin-bottom: 16px;
  scrollbar-width: none;
}
.filters::-webkit-scrollbar { display: none; }
.filter-btn {
  background: var(--card);
  border: 1px solid var(--border);
  color: var(--muted);
  padding: 8px 14px;
  border-radius: 50px;
  font-size: 0.82rem;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
  flex-shrink: 0;
}
.filter-btn:hover { color: var(--text); }
.filter-btn.active {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: white;
  border-color: transparent;
}
.filter-count {
  display: inline-block;
  background: rgba(0,0,0,0.25);
  padding: 1px 7px;
  border-radius: 50px;
  font-size: 0.7rem;
  margin-left: 4px;
}

/* Order list */
.orders { display: grid; gap: 10px; }

.order-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px;
  cursor: pointer;
  transition: all 0.2s;
}
.order-card:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(79,124,255,0.15);
}
.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
  flex-wrap: wrap;
}
.order-kode {
  font-family: 'Courier New', monospace;
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--accent);
}
.status-badge {
  font-size: 0.7rem;
  padding: 3px 10px;
  border-radius: 50px;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}
.status-pending { background: rgba(136,146,184,0.2); color: #a8b0cf; }
.status-menunggu_verifikasi { background: rgba(234,179,8,0.2); color: #facc15; }
.status-verified { background: rgba(34,197,94,0.2); color: #4ade80; }
.status-ditolak { background: rgba(239,68,68,0.2); color: #f87171; }

.order-game {
  font-weight: 600;
  font-size: 0.92rem;
  margin-bottom: 4px;
}
.order-info {
  font-size: 0.78rem;
  color: var(--muted);
  display: flex;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
}
.order-info strong { color: var(--text); }
.order-price { color: var(--accent); font-weight: 700; }

.empty {
  text-align: center;
  padding: 60px 20px;
  color: var(--muted);
}
.empty-icon { font-size: 3rem; margin-bottom: 12px; opacity: 0.5; }

/* ============ MODAL DETAIL ============ */
.modal {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.7);
  backdrop-filter: blur(6px);
  display: none;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
}
.modal.show { display: flex; }
@media (min-width: 640px) {
  .modal { align-items: center; padding: 20px; }
}

.modal-box {
  background: var(--card);
  border-radius: 20px 20px 0 0;
  width: 100%;
  max-width: 520px;
  max-height: 92vh;
  overflow-y: auto;
  padding: 22px;
  position: relative;
  animation: slideUp 0.3s ease-out;
}
@media (min-width: 640px) {
  .modal-box { border-radius: 18px; }
}
@keyframes slideUp {
  from { transform: translateY(40px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.modal-close {
  position: absolute;
  top: 14px; right: 16px;
  background: none;
  border: none;
  color: var(--muted);
  font-size: 1.6rem;
  cursor: pointer;
  line-height: 1;
}

.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
  gap: 8px;
}

.detail-section {
  margin-bottom: 18px;
}
.detail-section h4 {
  font-size: 0.75rem;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 10px;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 9px 0;
  font-size: 0.88rem;
  gap: 12px;
}
.detail-row .label { color: var(--muted); flex-shrink: 0; }
.detail-row .value {
  font-weight: 600;
  text-align: right;
  word-break: break-word;
  min-width: 0;
;
}

.bukti-img {
  width: 100%;
  border-radius: 12px;
  border: 1px solid var(--border);
  cursor: zoom-in;
  display: block;
}
.bukti-none {
  padding: 30px;
  text-align: center;
  color: var(--muted);
  background: var(--card-2);
  border-radius: 12px;
  font-size: 0.85rem;
}

.catatan-input {
  width: 100%;
  padding: 11px 13px;
  background: var(--card-2);
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text);
  font-size: 0.88rem;
  outline: none;
  font-family: inherit;
  resize: vertical;
  min-height: 70px;
}
.catatan-input:focus { border-color: var(--accent); }

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 16px;
}
.action-row .btn { padding: 13px; font-size: 0.9rem; }

/* Zoom image */
.zoom {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.95);
  z-index: 200;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  cursor: zoom-out;
}
.zoom.show { display: flex; }
.zoom img {
  max-width: 100%;
  max-height: 100%;
  border-radius: 8px;
}

/* Loading overlay */
.loading-spinner {
  width: 32px; height: 32px;
  border-radius: 50%;
  border: 3px solid var(--border);
  border-top-color: var(--accent);
  animation: spin 0.8s linear infinite;
  margin: 30px auto;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* Toast */
.toast {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  background: var(--card);
  border: 1px solid var(--border);
  padding: 12px 20px  border-radius: 50px;
  font-size: 0.88rem;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  z-index: 300;
  transition: transform 0.3s ease;
  max-width: 90vw;
  text-align: center;
}
.toast.show { transform: translateX(-50%) translateY(0); }
.toast.success { border-color: rgba(34,197,94,0.5); color: #4ade80; }
.toast.error { border-color: rgba(239,68,68,0.5); color: #f87171; }
</style>
</head>
<body>

<!-- ============ LOGIN ============ -->
<div class="login-screen" id="loginScreen">
  <div class="login-box">
    <div class="login-logo">🔐</div>
    <h1>Admin Dashboard</h1>
    <p class="sub">Login untuk mengelola pesanan</p>

    <div class="form-group">
      <label>Email</label>
      <input type="email" id="loginEmail" placeholder="admin@topup.com" autocomplete="email">
    </div>
    <div class="form-group">
      <label>Password</label>
      <input type="password" id="loginPassword" placeholder="••••••••" autocomplete="current-password">
    </div>

    <button class="btn btn-primary" id="btnLogin">Masuk</button>
    <div class="alert alert-error" id="loginAlert"></div>
  </div>
</div>

<!-- ============ DASHBOARD ============ -->
<div class="dashboard" id="dashboard">

  <div class="topbar">
    <div class="topbar-left">
      <div class="topbar-icon">⚡</div>
      <div>
        <div class="topbar-title">Admin Panel</div>
        <div class="topbar-user" id="topbarUser">—</div>
      </div>
    </div>
    <button class="btn btn-ghost" id="btnLogout" style="font-size:0.8rem; padding:8px 14px;">Keluar</button>
  </div>

  <div class="container">

    <!-- Stats -->
    <div class="stats">
      <div class="stat">
        <div class="stat-label">Total Pesanan</div>
        <div class="stat-value" id="statTotal">0</div>
      </div>
      <div class="stat">
        <div class="stat-label">Menunggu Verifikasi</div>
        <div class="stat-value yellow" id="statPending">0</div>
      </div>
      <div class="stat">
        <div class="stat-label">Terverifikasi</div>
        <div class="stat-value green" id="statVerified">0</div>
      </div>
      <div class="stat">
        <div class="stat-label">Total Revenue</div>
        <div class="stat-value accent" id="statRevenue">Rp 0</div>
      </div>
    </div>

    <!-- Filter -->
    <div class="filters" id="filters">
      <button class="filter-btn active" data-filter="all">Semua</button>
      <button class="filter-btn" data-filter="menunggu_verifikasi">Menunggu <span class="filter-count" id="cntMenunggu">0</span></button>
      <button class="filter-btn" data-filter="verified">Verified <span class="filter-count" id="cntVerified">0</span></button>
      <button class="filter-btn" data-filter="pending">Pending <span class="filter-count" id="cntPending">0</span></button>
      <button class="filter-btn" data-filter="ditolak">Ditolak <span class="filter-count" id="cntDitolak">0</span></button>
    </div>

    <!-- Order list -->
    <div class="orders" id="orders">
      <div class="loading-spinner"></div>
    </div>

  </div>
</div>

<!-- ============ MODAL DETAIL ============ -->
<div class="modal" id="detailModal">
  <div class="modal-box">
    <button class="modal-close" onclick="closeDetail()">×</button>

    <div class="detail-head">
      <div>
        <div style="font-size:0.72rem; color:var(--muted); letter-spacing:1.5px;">KODE PESANAN</div>
        <div class="order-kodeforEach" id="dKode" style="font-size:1(b => brem;">—</div>
      </div>
      <span class="status-b.classListadge" id="dStatus">—</.removespan>
    </div>

    <div class="detail-section">
      <h4>📦 Detail Pesanan</h4>
      <div class="detail-row"><span class="label">Game</span><span class="value" id="dGame">—</span></div>
      <div class="detail-row"><span class="label">Nominal</span><span class="value" id="dProduk">—</span></div>
      <div class="detail-row"><span class="label">User ID</span><span class="value" id="dUserId">—</span></div>
      <div class="detail-row" id="dZoneRow"><span class="label">Zone ID</span><span class="value" id="dZone">—</span></div>
      <div class="detail-row"><span class="label">Kontak</span><span class="value" id="dKontak">—</span></div>
      <div class="detail-row"><span class="label">Harga</span><span class="value order-price" id="dHarga">—</span></div>
      <div class="detail-row"><span class="label">Metode</span><span class="value" id="dMetode">—</span></div>
      <div class="detail-row"><span class="label">Waktu Order</span><span class="value" id="dWaktu">—</span></div>
    </div>

    <div class="detail-section">
      <h4>🖼️ Bukti Transfer</h4>
      <div id="dBuktiContainer"></div>
    </div>

    <div class="detail-section">
      <h4>📝 Catatan Admin</h4>
      <textarea class="catatan-input" id="dCatatan" placeholder="Catatan untuk pesanan ini (opsional)..."></textarea>
    </div>

    <div class="action-row" id="actionRow">
      <button class="btn btn-red" id="btnReject">✕ Tolak</button>
      <button class="btn btn-green" id="btnVerify">✓ Verifikasi</button>
    </div>
  </div>
</div>

<!-- Zoom image -->
<div class="zoom" id="zoom" onclick="closeZoom()">
  <img id="zoomImg" src="" alt="">
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="admin.js"></script>
</body>
</html>
